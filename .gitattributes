# These are YAML snapshot files generated by `insta`,
# but their bodies are Rust, and syntax highlighting them as Rust
# makes them much easier to read and review diffs for.
c2rust-transpile/tests/snapshots/*transpile*.c.snap linguist-language=Rust
c2rust-transpile/tests/snapshots/*transpile*.c.snap diff=Rust
c2rust-transpile/tests/snapshots/*transpile*.c.snap linguist-detectable

# Versioned upstream fixtures are retained byte-for-byte; their historical whitespace is not a
# c2das source-style violation.
tests/manual/h264bsd-mp4/upstream/** -whitespace
# wasm3 ships one CRLF file (source/wasm3_defs.h); keep upstream bytes exactly,
# including line endings, so the recorded revision stays byte-comparable.
tests/manual/wasm3/upstream/** -text -whitespace
