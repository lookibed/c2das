{
  "mcpServers": {
    "daslang": {
      "command": "${DASROOT:-../daScript}/bin/watchdog",
      "args": [
        "--stdio",
        "--name",
        "daslang-mcp",
        "--cwd",
        "${C2DAS_ROOT:-.}",
        "--program",
        "${DASROOT:-../daScript}/bin/daslang",
        "--",
        "-ignore-manifest",
        "${DASROOT:-../daScript}/utils/mcp/main.das"
      ],
      "env": {
        "DAS_LINT_CONFIG_PATH": "${C2DAS_ROOT:-.}/.lint_config"
      },
      "defer_loading": false
    },
    "daslang-dap": {
      "command": "${DASROOT:-../daScript}/bin/watchdog",
      "args": [
        "--stdio",
        "--name",
        "daslang-dap",
        "--cwd",
        "${C2DAS_ROOT:-.}",
        "--program",
        "${DASROOT:-../daScript}/bin/daslang",
        "--",
        "${DASROOT:-../daScript}/utils/dap/main.das",
        "--",
        "--repo-root",
        "${C2DAS_ROOT:-.}",
        "--executable",
        "${DASROOT:-../daScript}/bin/daslang"
      ]
    }
  }
}
