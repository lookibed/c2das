[export]
def insertion_sort(n : int const; var p : int?) {
    var i : int = 1
    while (i < int(n)) {
        var tmp : int const = int(unsafe(unsafe(unsafe(reinterpret<int?>(p)))[uint(i)]))
        var j : int = int(i)
        while (int(j) > 0 && unsafe(unsafe(unsafe(reinterpret<int?>(p)))[int(j) - 1]) > int(tmp)) {
            unsafe(unsafe(unsafe(reinterpret<int?>(p)))[uint(j)]) = unsafe(unsafe(unsafe(reinterpret<int?>(p)))[int(j) - 1])
            unsafe(unsafe(unsafe(reinterpret<int?>(p)))[uint(j)])
            j = j - 1
            j
        }
        unsafe(unsafe(unsafe(reinterpret<int?>(p)))[uint(j)]) = tmp
        unsafe(unsafe(unsafe(reinterpret<int?>(p)))[uint(j)])
        i = i + 1
    }
}

[export] def main() : int {
