let VALUE2 : int = 1

let VALUE1 : int = 0

let VALUE4 : int = 1

let VALUE3 : int = 0

[export, sideeffects]
def struct_declaration() {
    var value : int
    var a : AnonEnumInStruct
    var b : AnonStructInStruct
    var c : NestedStructInStruct
    var d : InsideStruct
    value = 1
    b.c2da_unnamed.some_number = 7
    return
}
[export, sideeffects]
def union_declaration() {
    var value_0 : int
    var a_0 : AnonEnumInUnion = AnonEnumInUnion(c2da_storage = c2da_rt_calloc(1ul, 4ul))
    var b_0 : AnonStructInUnion = AnonStructInUnion(c2da_storage = c2da_rt_calloc(1ul, 4ul))
    var c_0 : NestedStructInUnion = NestedStructInUnion(c2da_storage = c2da_rt_calloc(1ul, 4ul))
