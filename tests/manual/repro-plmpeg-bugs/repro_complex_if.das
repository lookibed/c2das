    total_size : uint64
    length : uint64
    has_ended : int
}
[export]
def repro_complex_if(var self : buffer_t?) : int {
    if (uint64(uint64(self.total_size)) != uint64(0) && uint64(self.length) == uint64(self.total_size)) {
        self.has_ended = 1
    }
    return 0
}
